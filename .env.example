# Copy this file to .env (which is gitignored) and fill in real values.
# docker-compose.yml reads these automatically.

# Required — must satisfy SQL Server's password complexity rules
# (8+ chars, upper + lower + digit or symbol).
MSSQL_SA_PASSWORD=Change_This_Password123!

# Optional — leave blank to keep Google/LinkedIn sign-in disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional — leave blank to keep outbound email disabled. For Gmail, this must be
# an App Password (Google Account → Security → 2-Step Verification → App passwords),
# not your regular account password.
SMTP_SENDER_EMAIL=
SMTP_PASSWORD=

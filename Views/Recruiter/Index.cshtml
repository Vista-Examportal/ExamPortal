                        {
                            var noteColor = note.Status == "Sent" ? "success" : note.Status == "Failed" ? "danger" : "warning";
                            <tr>
                                <td class="px-5 py-3 font-semibold text-slate-800 dark:text-slate-100" data-sort-value="@note.User?.FullName">@note.User?.FullName</td>

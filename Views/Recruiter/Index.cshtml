            <div class="ui-card-body">
                @{ ViewData["TableId"] = "recruiterNotificationsTable"; ViewData["ShowPageSize"] = true; ViewData["SearchPlaceholder"] = "Search notifications..."; }
                @await Html.PartialAsync("_TableToolbar")
                <div class="overflow-x-auto">
                    <table id="recruiterNotificationsTable" class="ui-table" data-smart-table data-sortable data-page-size="10">
                        <thead class="border-b border-slate-100 text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400 dark:border-slate-700"><tr><th class="px-5 py-3 font-medium" data-sort-key="recipient">Recipient</th><th class="px-5 py-3 font-medium" data-sort-key="subject">Subject</th><th class="px-5 py-3 font-medium" data-sort-key="status">Status</th><th class="px-5 py-3 font-medium" data-sort-key="created" data-sort-type="date">Created</th></tr></thead>
                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700">

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script>
        // Invitation Status chart — same skeleton-then-render pattern as the
        // candidate dashboard's Chart.js chart (Home/Index.cshtml), reusing
        // invitation-status counts already computed above from the existing
        // invitations list.
        (function () {
            var ctx = document.getElementById('invitationStatusChart');
            var skeleton = document.getElementById('invitationStatusSkeleton');
            if (!ctx || !window.Chart) return;
            // Read the real design-system colors instead of a separate hardcoded
            // hex palette that could (and previously did) drift from the actual
            // --vw-warning/success/info/text-muted values used everywhere else.
            var css = getComputedStyle(document.documentElement);
            var palette = [
                css.getPropertyValue('--vw-warning').trim(),
                css.getPropertyValue('--vw-success').trim(),
                css.getPropertyValue('--vw-info').trim(),
                css.getPropertyValue('--vw-text-muted').trim()
            ];
            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Pending', 'Accepted', 'Used', 'Other'],
                    datasets: [{
                        data: [@pendingInvites, @acceptedInvites, @usedInvites, @otherInvites],
                        backgroundColor: palette,
                        borderWidth: 0
                    }]
                },
                options: {
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 11 } } } },
                    cutout: '65%'
                }
            });
            skeleton.classList.add('hidden');
            ctx.classList.remove('hidden');
        })();

        // Assign Assessment: the visible field is a browser-local datetime-local
        // picker with no timezone info attached to its raw value (e.g. "2026-07-20T09:00").
        // Posting that string as-is let the server interpret it in the SERVER's local
        // timezone rather than the recruiter's, which could silently shift the actual
        // opening time by several hours — candidates would then see "This assessment
        // opens on ..." even though, from the recruiter's perspective, it should already
        // be open. Converting to a UTC ISO string here removes the ambiguity: the value
        // that reaches AssignAssessment always means the same instant regardless of
        // where the app server happens to be hosted.
        (function () {
            var form = document.querySelector('form[action$="AssignAssessment"], form[asp-action="AssignAssessment"]');
            var localInput = document.getElementById('assignAssessmentDateLocal');
            var utcInput = document.getElementById('assignAssessmentDateUtc');
            if (!form || !localInput || !utcInput) return;

            form.addEventListener('submit', function (e) {
                if (!localInput.value) return; // let native 'required' validation handle empty
                var parsed = new Date(localInput.value);
                if (isNaN(parsed.getTime())) {
                    e.preventDefault();
                    localInput.setCustomValidity('Enter a valid date and time.');
                    localInput.reportValidity();
                    return;
                }
                localInput.setCustomValidity('');
                utcInput.value = parsed.toISOString();
            });
        })();
    </script>
}

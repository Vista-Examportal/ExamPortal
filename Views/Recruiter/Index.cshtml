                        {
                            <tr data-sort-exclude><td colspan="4" class="p-0">@await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Icon = "bell", Title = "No notifications yet", Message = "Emails and alerts sent to candidates will be logged here.", Compact = true })</td></tr>

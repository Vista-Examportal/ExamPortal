@model ExamResultViewModel
@{ ViewData["Title"] = "Assessment Submitted"; }

<!-- Submission acknowledgement — scores are NOT shown to the candidate -->
<div class="mx-auto max-w-2xl">
    <div class="ui-card text-center animate-fade-in">
        <div class="ui-card-body py-5 sm:py-8">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-[var(--vw-success-bg)] text-[var(--vw-success)]">
                <i data-lucide="send" class="h-8 w-8"></i>
            </div>
            <h1 class="text-2xl font-bold text-[var(--vw-text)]">Assessment Submitted Successfully</h1>
            <p class="text-[var(--vw-text-secondary)] text-lg mt-1 mb-0">@Model.Exam.Title</p>

            <div class="ui-alert-info mx-auto mt-5 max-w-md text-left">
                <div class="ui-alert-icon"><i data-lucide="info" class="h-4 w-4"></i></div>
                <div>
                    Your responses have been recorded. You can track its status any time in
                    <a asp-controller="Home" asp-action="Results" class="font-semibold underline underline-offset-2">My Assessments</a>.
                    Our recruitment team will reach out with an update.
                </div>
            </div>

            <p class="text-sm text-[var(--vw-text-muted)] mt-4 mb-0">
                Submitted on @Model.Attempt.SubmittedAt?.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
            </p>

            <div class="mt-5">
                <a asp-controller="Home" asp-action="Index" class="ui-btn-primary">
                    <i data-lucide="home" class="h-4 w-4"></i>Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

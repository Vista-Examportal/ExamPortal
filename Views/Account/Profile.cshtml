@model User
@{ ViewData["Title"] = "My Profile"; }

<div class="mx-auto max-w-2xl space-y-6">

    <div class="vw-page-header">
        <div class="vw-page-header-main">
            <div class="vw-page-header-icon"><i data-lucide="circle-user-round"></i></div>
            <div>
                <h1 class="vw-page-title no-icon">My Profile</h1>
                <p class="vw-page-subtitle">Your account details.</p>
            </div>
        </div>
        <span class="ui-badge-neutral shrink-0 !px-3 !py-1.5 !text-sm">@Model.Role</span>
    </div>

    <div class="ui-card">
        <div class="ui-card-body space-y-4">
            <div>
                <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Full name</div>
                <div class="text-sm text-slate-800 dark:text-slate-100">@Model.FullName</div>
            </div>
            <div>
                <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Email</div>
                <div class="text-sm text-slate-800 dark:text-slate-100">@Model.Email</div>
            </div>
            <div>
                <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Phone</div>
                <div class="text-sm text-slate-800 dark:text-slate-100">@(string.IsNullOrWhiteSpace(Model.MobileNumber) ? "—" : Model.MobileNumber)</div>
            </div>
            <div>
                <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Member since</div>
                <div class="text-sm text-slate-800 dark:text-slate-100">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
            </div>
        </div>
    </div>

    <p class="text-xs text-slate-500 dark:text-slate-400">To update these details or reset your password, contact an Admin.</p>
</div>

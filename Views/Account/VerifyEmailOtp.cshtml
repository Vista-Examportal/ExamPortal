@model EmailOtpViewModel
@{ ViewData["Title"] = "Verify Email"; Layout = "_AuthLayout"; ViewData["TitleSuffix"] = "VISTAWAYS TECH"; }
<div class="w-full max-w-md">
    <div class="ui-card overflow-hidden">
        <div class="p-8 sm:p-10">
            <div class="text-center mb-6">
                <a asp-controller="Site" asp-action="Index" class="inline-block rounded-lg hover:opacity-90" aria-label="Back to home">
                    <img src="~/logo-full.png" alt="VISTAWAYS TECH — Innovation. Integration. Impact." class="h-14 w-auto object-contain mx-auto mb-3" width="2047" height="561" />
                </a>
                <i data-lucide="mail-check" class="h-8 w-8 mx-auto mb-3 text-[var(--vw-accent)]"></i>
                <h1 class="vw-page-title no-icon">Verify Your Email</h1>
                <p class="text-sm text-slate-500 dark:text-slate-400">Step 2 of 6 — Enter the 6-digit OTP sent to <strong>@Model.Email</strong>.</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="ui-alert-success mb-4" role="status" data-dismissible>
                    <div class="ui-alert-icon"><i data-lucide="circle-check" class="h-4 w-4"></i></div>
                    <span>@TempData["Success"]</span>
                </div>
            }
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="ui-alert-danger mb-4" role="alert" aria-live="assertive">
                    <div class="ui-alert-icon"><i data-lucide="circle-alert" class="h-4 w-4"></i></div>
                    <div>@Html.ValidationSummary(false, null, new { @class = "space-y-0.5" })</div>
                </div>
            }

            <form asp-action="VerifyEmailOtp" method="post" novalidate class="space-y-5">
                <input asp-for="Email" type="hidden" />
                <div>
                    <label for="otpInput" class="ui-label">OTP<span class="ui-required" aria-hidden="true">*</span></label>
                    <input id="otpInput" asp-for="Otp" class="ui-field vw-otp-input text-center font-bold text-lg"
                           maxlength="6" inputmode="numeric" pattern="\d*" autocomplete="one-time-code"
                           required aria-required="true"
                           aria-describedby="otpHint err-otp" />
                    <div id="otpHint" class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">Enter the 6-digit code. Expires 15 minutes after it's sent.</div>
                    <span asp-validation-for="Otp" id="err-otp" class="ui-field-error"></span>
                </div>

                <button type="submit" id="otpSubmit" class="ui-btn-primary w-full py-2.5 font-semibold">
                    Verify Email
                </button>
            </form>

            <form asp-action="ResendEmailOtp" method="post" class="mt-2">
                <button type="submit" class="w-full py-2 text-sm font-semibold text-[var(--vw-accent)] hover:underline">Resend OTP</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Icons are rendered centrally by app.js's renderIcons() on DOMContentLoaded.
        document.querySelector('form[action*="VerifyEmailOtp"]').addEventListener("submit", function (e) {
            if (e.defaultPrevented) return;
            var btn = document.getElementById("otpSubmit");
            setTimeout(function () {
                btn.disabled = true;
                btn.innerHTML = '<span class="ui-loader"></span>Verifying…';
            }, 0);
        });
    </script>
}

@model ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot Password"; Layout = "_AuthLayout"; }
<div class="w-full max-w-md">
    <div class="ui-card overflow-hidden">
        <div class="p-8 sm:p-10">
            <div class="text-center mb-6">
                <a asp-controller="Site" asp-action="Index" class="inline-block rounded-lg hover:opacity-90" aria-label="Back to home">
                    <img src="~/logo-full.png" alt="VISTAWAYS TECH — Innovation. Integration. Impact." class="h-16 w-auto object-contain mx-auto mb-3" width="2047" height="561" />
                </a>
                <h1 class="vw-page-title no-icon">Forgot Password</h1>
                <p class="text-sm text-slate-500 dark:text-slate-400">Enter your registered email and we'll send you a reset link.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="ui-alert-danger mb-4" role="alert" aria-live="assertive">
                    <div class="ui-alert-icon"><i data-lucide="circle-alert" class="h-4 w-4"></i></div>
                    <div>@Html.ValidationSummary(true, null, new { @class = "space-y-0.5" })</div>
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="ui-alert-success mb-4" role="status" data-dismissible>
                    <div class="ui-alert-icon"><i data-lucide="circle-check" class="h-4 w-4"></i></div>
                    <span>@TempData["Success"]</span>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="ui-alert-danger mb-4" role="alert" data-dismissible>
                    <div class="ui-alert-icon"><i data-lucide="circle-alert" class="h-4 w-4"></i></div>
                    <span>@TempData["Error"]</span>
                </div>
            }

            <form asp-action="ForgotPassword" method="post" novalidate class="space-y-5">
                <div>
                    <label for="fpEmail" class="ui-label">Email<span class="ui-required" aria-hidden="true">*</span></label>
                    <div class="ui-input-icon-wrap">
                        <i data-lucide="mail" class="ui-input-icon h-4 w-4" aria-hidden="true"></i>
                        <input id="fpEmail" asp-for="Email" class="ui-field" type="email"
                               autocomplete="username"
                               required aria-required="true" aria-describedby="err-fpEmail" />
                    </div>
                    <span asp-validation-for="Email" id="err-fpEmail" class="ui-field-error"></span>
                </div>

                <button type="submit" id="fpSubmit" class="ui-btn-primary w-full py-2.5 font-semibold">
                    <i data-lucide="send" class="h-4 w-4"></i>Send Reset Link
                </button>
            </form>

            <p class="text-center mt-5 text-sm text-slate-500 dark:text-slate-400">
                <a asp-action="Login" class="font-semibold text-[var(--vw-accent)] hover:underline inline-flex items-center gap-1">
                    <i data-lucide="arrow-left" class="h-4 w-4"></i>Back to login
                </a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Icons are rendered centrally by app.js's renderIcons() on DOMContentLoaded,
        // same pattern used site-wide.
        document.querySelector("form").addEventListener("submit", function (e) {
            if (e.defaultPrevented) return;
            var btn = document.getElementById("fpSubmit");
            setTimeout(function () {
                btn.disabled = true;
                btn.innerHTML = '<span class="ui-loader"></span>Sending…';
            }, 0);
        });
    </script>
}

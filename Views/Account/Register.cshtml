@model CandidateRegistrationViewModel
@{ ViewData["Title"] = "Create Account"; Layout = "_AuthLayout"; ViewData["TitleSuffix"] = "VISTAWAYS TECH"; }
<div class="w-full max-w-md">
    <div class="ui-card overflow-hidden">
        <div class="p-8 sm:p-10">
            <div class="text-center mb-6">
                <a asp-controller="Site" asp-action="Index" class="inline-block rounded-lg hover:opacity-90" aria-label="Back to home">
                    <img src="~/logo-full.png" alt="VISTAWAYS TECH — Innovation. Integration. Impact." class="h-16 w-auto object-contain mx-auto mb-3" width="2047" height="561" />
                </a>
                <h1 class="vw-page-title no-icon">Create Your Account</h1>
                <p class="text-sm text-slate-500 dark:text-slate-400">Just 5 fields. Profile details come next.</p>
            </div>

            <!-- Step progress -->
            <div aria-label="Registration progress, step 1 of 4" class="mb-6">
                <div class="vw-step-progress-label">
                    <span>Step 1 of 4</span>
                    <span>Account details</span>
                </div>
                <div class="vw-step-progress-track">
                    <div class="vw-step-progress-seg done" title="Step 1: Account"></div>
                    <div class="vw-step-progress-seg" title="Step 2: Verify Email"></div>
                    <div class="vw-step-progress-seg" title="Step 3: Personal Profile"></div>
                    <div class="vw-step-progress-seg" title="Step 4: Resume, Skills &amp; Preferences"></div>
                </div>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="ui-alert-danger mb-4" role="alert" aria-live="assertive">
                    <div class="ui-alert-icon"><i data-lucide="circle-alert" class="h-4 w-4"></i></div>
                    <div>@Html.ValidationSummary(false, null, new { @class = "space-y-0.5" })</div>
                </div>
            }

            <form asp-action="Register" method="post" novalidate class="space-y-5">
                <div>
                    <label asp-for="FullName" class="ui-label">Full Name<span class="ui-required" aria-hidden="true">*</span></label>
                    <div class="ui-input-icon-wrap">
                        <i data-lucide="user" class="ui-input-icon h-4 w-4" aria-hidden="true"></i>
                        <input asp-for="FullName" class="ui-field" autocomplete="name"
                               aria-required="true" aria-describedby="err-FullName" data-live-validate="fullname" />
                    </div>
                    <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">As it appears on your ID.</p>
                    <span asp-validation-for="FullName" id="err-FullName" class="ui-field-error"></span>
                </div>

                <div>
                    <label asp-for="Email" class="ui-label">Email<span class="ui-required" aria-hidden="true">*</span></label>
                    <div class="ui-input-icon-wrap">
                        <i data-lucide="mail" class="ui-input-icon h-4 w-4" aria-hidden="true"></i>
                        <input asp-for="Email" class="ui-field" type="email" autocomplete="email"
                               aria-required="true" aria-describedby="err-Email" data-live-validate="email" />
                    </div>
                    <span asp-validation-for="Email" id="err-Email" class="ui-field-error"></span>
                </div>

                <div>
                    <label asp-for="PhoneNumber" class="ui-label">Phone Number<span class="ui-required" aria-hidden="true">*</span></label>
                    <div class="ui-input-icon-wrap">
                        <i data-lucide="phone" class="ui-input-icon h-4 w-4" aria-hidden="true"></i>
                        <input asp-for="PhoneNumber" class="ui-field" type="tel" autocomplete="tel"
                               aria-required="true" aria-describedby="err-PhoneNumber" data-live-validate="phone" />
                    </div>
                    <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">e.g. +91 98765 43210</p>
                    <span asp-validation-for="PhoneNumber" id="err-PhoneNumber" class="ui-field-error"></span>
                </div>

                <div>
                    <label asp-for="Password" for="pwField" class="ui-label">Password<span class="ui-required" aria-hidden="true">*</span></label>
                    <div class="ui-input-icon-wrap">
                        <i data-lucide="lock" class="ui-input-icon h-4 w-4" aria-hidden="true"></i>
                        <input asp-for="Password" class="ui-field pr-10" id="pwField" autocomplete="new-password"
                               aria-required="true" aria-describedby="err-Password pw-hint"
                               data-pw-strength="pwStrength" />
                        <button type="button" class="pw-toggle-inline" data-pw-toggle="pwField" aria-label="Show password">
                            <i data-lucide="eye" class="h-4 w-4"></i>
                        </button>
                    </div>
                    <div id="pwStrength" class="pw-strength" aria-live="polite">
                        <div class="pw-strength-track">
                            <div class="pw-strength-seg"></div>
                            <div class="pw-strength-seg"></div>
                            <div class="pw-strength-seg"></div>
                            <div class="pw-strength-seg"></div>
                        </div>
                        <span class="pw-strength-label"></span>
                    </div>
                    <div id="pw-hint" class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">At least 8 characters, with a mix of uppercase, lowercase, numbers, and symbols.</div>
                    <span asp-validation-for="Password" id="err-Password" class="ui-field-error"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" for="pwConfirmField" class="ui-label">Confirm Password<span class="ui-required" aria-hidden="true">*</span></label>
                    <div class="ui-input-icon-wrap">
                        <i data-lucide="lock" class="ui-input-icon h-4 w-4" aria-hidden="true"></i>
                        <input asp-for="ConfirmPassword" class="ui-field pr-10" id="pwConfirmField" autocomplete="new-password"
                               aria-required="true" aria-describedby="err-ConfirmPassword"
                               data-pw-match="pwField" data-pw-match-hint="pwMatchHint" />
                        <button type="button" class="pw-toggle-inline" data-pw-toggle="pwConfirmField" aria-label="Show confirm password">
                            <i data-lucide="eye" class="h-4 w-4"></i>
                        </button>
                    </div>
                    <span id="pwMatchHint" class="pw-match-hint" aria-live="polite"></span>
                    <span asp-validation-for="ConfirmPassword" id="err-ConfirmPassword" class="ui-field-error"></span>
                </div>

                <button type="submit" id="registerSubmit" class="ui-btn-primary w-full py-2.5 font-semibold">
                    <i data-lucide="mail" class="h-4 w-4"></i>Create Account &amp; Send OTP
                </button>
            </form>

            @* Candidate registration only (this page has no Recruiter/HR/Admin
               equivalent — staff accounts are provisioned by an Admin, not
               self-registered). A Google sign-up skips the OTP step entirely since
               Google has already verified the email — see
               AccountController.ExternalAuth.cs / CreateGoogleCandidate. *@
            @await Html.PartialAsync("_GoogleSignInButton", "Sign up with Google")

            <p class="text-center mt-5 text-sm text-slate-500 dark:text-slate-400">
                Already have an account? <a asp-action="Login" class="font-semibold text-[var(--vw-accent)] hover:underline">Sign In</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Icons, password toggle/strength/match are all wired centrally in
        // app.js off the data- attributes above, same as Login.cshtml.
        document.querySelector("form").addEventListener("submit", function (e) {
            if (e.defaultPrevented) return;
            var btn = document.getElementById("registerSubmit");
            setTimeout(function () {
                btn.disabled = true;
                btn.innerHTML = '<span class="ui-loader"></span>Creating account…';
            }, 0);
        });
    </script>
}

@{ ViewData["Title"] = "Secure Assessment Access"; Layout = "_AuthLayout"; ViewData["TitleSuffix"] = "VISTAWAYS TECH"; }
<div class="w-full max-w-md">
    <div class="ui-card overflow-hidden">
        <div class="p-8 sm:p-10">
            <div class="text-center mb-6">
                <a asp-controller="Site" asp-action="Index" class="inline-block rounded-lg hover:opacity-90" aria-label="Back to home">
                    <img src="~/logo-full.png" alt="VISTAWAYS TECH — Innovation. Integration. Impact." class="h-14 w-auto object-contain mx-auto mb-3" width="2047" height="561" />
                </a>
                <div class="vw-secure-badge px-3 py-2 inline-flex items-center gap-2 mb-3">
                    <i data-lucide="shield" class="h-4 w-4"></i>
                    <span>Secure Assessment Link</span>
                </div>
                <h1 class="vw-page-title no-icon">Verify Your Identity</h1>
                <p class="text-sm text-slate-500 dark:text-slate-400">Please authenticate using your Candidate ID or email and password to access the assessment.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="ui-alert-danger mb-4" role="alert" aria-live="assertive">
                    <div class="ui-alert-icon"><i data-lucide="circle-alert" class="h-4 w-4"></i></div>
                    <div>@Html.ValidationSummary(true, null, new { @class = "space-y-0.5" })</div>
                </div>
            }

            <form method="post" asp-action="AssessmentAuth" novalidate class="space-y-5">
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@ViewBag.Token" />

                <div>
                    <label for="authCandidateId" class="ui-label">Candidate ID or Email<span class="ui-required" aria-hidden="true">*</span></label>
                    <div class="ui-input-icon-wrap">
                        <i data-lucide="contact" class="ui-input-icon h-4 w-4" aria-hidden="true"></i>
                        <input id="authCandidateId" type="text" name="candidateId" class="ui-field"
                               autocomplete="username" required aria-required="true" />
                    </div>
                </div>

                <div>
                    <label for="authPassword" class="ui-label">Password</label>
                    <div class="ui-input-icon-wrap">
                        <i data-lucide="lock" class="ui-input-icon h-4 w-4" aria-hidden="true"></i>
                        <input id="authPassword" type="password" name="password" class="ui-field pr-10"
                               autocomplete="current-password" aria-describedby="authMethodHint" />
                        <button type="button" class="pw-toggle-inline" data-pw-toggle="authPassword" aria-label="Show password">
                            <i data-lucide="eye" class="h-4 w-4"></i>
                        </button>
                    </div>
                </div>

                <div>
                    <label for="authToken" class="ui-label">One-Time Login Token</label>
                    <div class="ui-input-icon-wrap">
                        <i data-lucide="key" class="ui-input-icon h-4 w-4" aria-hidden="true"></i>
                        <input id="authToken" type="text" name="oneTimeLoginToken" class="ui-field"
                               inputmode="numeric" aria-describedby="authMethodHint" />
                    </div>
                    <div id="authMethodHint" class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">Use either your password or the one-time token sent in the assessment email.</div>
                </div>

                <button type="submit" id="authSubmit" class="ui-btn-primary w-full py-2.5 font-semibold">
                    <i data-lucide="arrow-right" class="h-4 w-4"></i>Authenticate &amp; Start Assessment
                </button>
            </form>

            <p class="text-center mt-5 text-sm text-slate-500 dark:text-slate-400 inline-flex items-center gap-1 justify-center w-full">
                <i data-lucide="info" class="h-4 w-4"></i>This link is unique to you. Do not share it.
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Icons and password toggle are wired centrally in app.js off the
        // data-lucide / data-pw-toggle attributes above, same as Login.cshtml.
        document.querySelector("form").addEventListener("submit", function (e) {
            if (e.defaultPrevented) return;
            var btn = document.getElementById("authSubmit");
            setTimeout(function () {
                btn.disabled = true;
                btn.innerHTML = '<span class="ui-loader"></span>Authenticating…';
            }, 0);
        });
    </script>
}

@{
    ViewData["Title"] = "Careers at VISTAWAYS TECH";
    ViewData["MetaDescription"] = "Explore open roles at VISTAWAYS TECH. Every hire starts with a real, timed skills assessment and a transparent hiring pipeline — see open positions, benefits, and what it's actually like to work here.";
    ViewData["TransparentHero"] = true;
}

@* ================================================================
   HERO — company introduction
   ================================================================ *@
<section class="vw-hero" data-hero>
    <div class="relative mx-auto max-w-5xl px-4 py-28 text-center sm:px-6 sm:py-36">
        <h1 class="mx-auto max-w-3xl text-4xl font-extrabold leading-[1.1] tracking-tight text-white sm:text-5xl lg:text-6xl">
            Showcase your skills.<br class="hidden sm:block" /> Unlock career opportunities.
        </h1>
        <p class="mx-auto mt-6 max-w-xl text-base text-slate-300 sm:text-lg">
            At VISTAWAYS TECH, every hire starts with real work — a live assessment, a transparent
            pipeline, and a team that reviews your code, not just your resume.
        </p>
        <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href="#careers" class="ui-btn-primary w-full px-7 py-3 text-base sm:w-auto">
                <i data-lucide="compass" class="h-4 w-4"></i>Explore careers
            </a>
            <a href="#why-join" class="w-full rounded-lg border border-white/25 px-7 py-3 text-base font-semibold text-white transition-colors hover:bg-white/10 sm:w-auto text-center">
                Learn about us
            </a>
        </div>
        <dl class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-6 border-t border-white/10 pt-8 sm:grid-cols-3 sm:gap-4">
            <div>
                <dt class="sr-only">Open roles</dt>
                <dd class="text-2xl font-bold text-white sm:text-3xl">40<span class="text-cyan-400">+</span></dd>
                <dd class="mt-1 text-xs text-slate-400">open roles</dd>
            </div>
            <div>
                <dt class="sr-only">Average time to offer</dt>
                <dd class="text-2xl font-bold text-white sm:text-3xl">12<span class="text-cyan-400">d</span></dd>
                <dd class="mt-1 text-xs text-slate-400">avg. time to offer</dd>
            </div>
            <div>
                <dt class="sr-only">Engineers on the team</dt>
                <dd class="text-2xl font-bold text-white sm:text-3xl">300<span class="text-cyan-400">+</span></dd>
                <dd class="mt-1 text-xs text-slate-400">people on the team</dd>
            </div>
        </dl>
    </div>
</section>

<div class="mx-auto max-w-6xl px-4 sm:px-6">

@* ================================================================
   FEATURED JOBS / LATEST OPPORTUNITIES — primary section, moved up:
   this is what most visitors came here to see, ahead of company copy.
   ================================================================ *@
<section id="careers" class="py-20 scroll-mt-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <h2 class="text-3xl font-bold tracking-tight text-[var(--vw-text)] sm:text-4xl">Open positions</h2>
        </div>
        <a asp-controller="Account" asp-action="Register" class="ui-btn-outline">
            View all openings<i data-lucide="arrow-right" class="h-4 w-4"></i>
        </a>
    </div>

    @* Client-side only: this page has no persisted Job/JobPosting table
       (see the note on OpenRoleViewModel in Models/Models.cs), so this
       filters the static list below in the browser rather than pretending
       to hit a search API that doesn't exist. *@
    <div class="mt-8 grid gap-3 sm:grid-cols-4" id="jobsFilterBar">
        <div class="sm:col-span-2">
            <label for="jobSearchInput" class="sr-only">Search by title or keyword</label>
            <div class="ui-input-icon-wrap">
                <i data-lucide="search" class="ui-input-icon h-4 w-4" aria-hidden="true"></i>
                <input type="text" id="jobSearchInput" class="ui-field" placeholder="Search by title or keyword" autocomplete="off" />
            </div>
        </div>
        <div>
            <label for="jobDeptFilter" class="sr-only">Department</label>
            <select id="jobDeptFilter" class="ui-field">
                <option value="">All departments</option>
                <option value="Engineering">Engineering</option>
                <option value="Data &amp; AI">Data &amp; AI</option>
                <option value="Quality">Quality</option>
                <option value="People">People</option>
            </select>
        </div>
        <div>
            <label for="jobTypeFilter" class="sr-only">Employment type</label>
            <select id="jobTypeFilter" class="ui-field">
                <option value="">All types</option>
                <option value="Full-time">Full-time</option>
                <option value="Graduate">Graduate</option>
            </select>
        </div>
    </div>

    <div class="mt-6 grid gap-4 lg:grid-cols-2" id="jobsGrid">
        @{
            var jobs = new (string Title, string Dept, string Location, string Type, string Icon)[] {
                ("Senior .NET Developer", "Engineering", "Hyderabad · Hybrid", "Full-time", "server"),
                ("React Frontend Engineer", "Engineering", "Bengaluru · Hybrid", "Full-time", "layout-panel-left"),
                ("SQL / Data Engineer", "Data & AI", "Remote (India)", "Full-time", "database"),
                ("QA & Assessment Engineer", "Quality", "Hyderabad · On-site", "Full-time", "shield-check"),
                ("Technical Recruiter", "People", "Bengaluru · Hybrid", "Full-time", "users-round"),
                ("Associate Software Engineer", "Engineering", "Hyderabad · On-site", "Graduate", "graduation-cap"),
            };
        }
        @foreach (var job in jobs)
        {
            <a asp-controller="Account" asp-action="Register" class="vw-feature-card flex items-start gap-4 !p-5"
               data-job-title="@job.Title.ToLowerInvariant()" data-job-dept="@job.Dept" data-job-location="@job.Location.ToLowerInvariant()" data-job-type="@job.Type">
                <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-[var(--vw-accent-bg)] text-[var(--vw-accent-text)]">
                    <i data-lucide="@job.Icon" class="h-5 w-5"></i>
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                        <h3 class="font-semibold text-[var(--vw-text)]">@job.Title</h3>
                        <span class="ui-badge-neutral !text-[.68rem]">@job.Type</span>
                    </div>
                    <p class="mt-1 text-sm text-[var(--vw-text-muted)]">@job.Dept &middot; @job.Location</p>
                </div>
                <i data-lucide="chevron-right" class="mt-2 h-4 w-4 shrink-0 text-[var(--vw-text-muted)]"></i>
            </a>
        }
    </div>
    <p id="jobsEmptyState" class="mt-6 hidden text-center text-sm text-[var(--vw-text-muted)]">No open positions match those filters right now — try clearing one.</p>
</section>

@* ================================================================
   WHY JOIN — primary section
   ================================================================ *@
<section id="why-join" class="py-20 border-t border-[var(--vw-border)] scroll-mt-20">
    <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-[var(--vw-text)] sm:text-4xl">Building technology that drives real results.</h2>
        <p class="mt-3 text-[var(--vw-text-secondary)]">Four things candidates tell us mattered most after they joined.</p>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <div class="vw-feature-card">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--vw-accent-bg)] text-[var(--vw-accent-text)]">
                <i data-lucide="code" class="h-5 w-5"></i>
            </div>
            <h3 class="ui-heading-sm mt-4">Real ownership, day one</h3>
            <p class="mt-1.5 text-sm text-[var(--vw-text-secondary)]">No ramp-up busywork — new hires ship to production in their first sprint, with a mentor reviewing alongside them.</p>
        </div>
        <div class="vw-feature-card">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--vw-secondary-bg)] text-[var(--vw-secondary-text)]">
                <i data-lucide="target" class="h-5 w-5"></i>
            </div>
            <h3 class="ui-heading-sm mt-4">Hired on skill, not pedigree</h3>
            <p class="mt-1.5 text-sm text-[var(--vw-text-secondary)]">Every technical role includes a real, timed assessment. Your code speaks before your resume does.</p>
        </div>
        <div class="vw-feature-card">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--vw-info-bg)] text-[var(--vw-info-text)]">
                <i data-lucide="layers" class="h-5 w-5"></i>
            </div>
            <h3 class="ui-heading-sm mt-4">A modern, opinionated stack</h3>
            <p class="mt-1.5 text-sm text-[var(--vw-text-secondary)]">.NET, React, and cloud-native tooling — chosen deliberately, kept current, no legacy systems nobody wants to touch.</p>
        </div>
        <div class="vw-feature-card">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--vw-success-bg)] text-[var(--vw-success-text)]">
                <i data-lucide="trending-up" class="h-5 w-5"></i>
            </div>
            <h3 class="ui-heading-sm mt-4">A visible path forward</h3>
            <p class="mt-1.5 text-sm text-[var(--vw-text-secondary)]">Level-up criteria are written down, not implied. You always know what the next step looks like.</p>
        </div>
    </div>
</section>

@* ================================================================
   BENEFITS — primary section
   ================================================================ *@
<section class="py-20 border-t border-[var(--vw-border)] scroll-mt-20">
    <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-[var(--vw-text)] sm:text-4xl">Employee benefits</h2>
    </div>
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @{
            var benefits = new (string Name, string Desc, string Icon)[] {
                ("Health coverage", "Comprehensive medical for you and your family, day one.", "heart-pulse"),
                ("Flexible work", "Hybrid by default; remote arrangements considered by role.", "home"),
                ("Learning budget", "Annual budget for courses, books, and conference travel.", "book-open"),
                ("Parental leave", "Paid leave for every parent, regardless of how your family grows.", "baby"),
                ("Performance bonus", "Company and individual performance reviewed twice a year.", "banknote"),
                ("Wellness time", "Dedicated leave separate from your regular vacation days.", "leaf"),
            };
        }
        @foreach (var b in benefits)
        {
            <div class="flex items-start gap-3 rounded-xl border border-[var(--vw-border)] bg-[var(--vw-surface)] p-5">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[var(--vw-secondary-bg)] text-[var(--vw-secondary-text)]">
                    <i data-lucide="@b.Icon" class="h-4 w-4"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-[var(--vw-text)]">@b.Name</h3>
                    <p class="mt-0.5 text-sm text-[var(--vw-text-secondary)]">@b.Desc</p>
                </div>
            </div>
        }
    </div>
</section>

@* ================================================================
   OFFICE CULTURE — primary section
   ================================================================ *@
<section id="culture" class="py-20 border-t border-[var(--vw-border)] scroll-mt-20">
    <div class="grid items-center gap-10 lg:grid-cols-2">
        <div>
            <h2 class="text-3xl font-bold tracking-tight text-[var(--vw-text)] sm:text-4xl">Hybrid, by design</h2>
            <p class="mt-4 text-[var(--vw-text-secondary)]">Teams choose their own in-office rhythm — most land on two or three days together for planning and pairing, with focus work done wherever it happens best. No mandated seat time, no tracked badge-swipes.</p>
            <ul class="mt-6 space-y-3">
                <li class="flex items-start gap-3 text-sm text-[var(--vw-text-secondary)]">
                    <i data-lucide="check" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--vw-success)]"></i>
                    Weekly demo Fridays — every team shows what shipped, not just engineering.
                </li>
                <li class="flex items-start gap-3 text-sm text-[var(--vw-text-secondary)]">
                    <i data-lucide="check" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--vw-success)]"></i>
                    Quarterly hack days — pitch anything, ship a prototype in 48 hours.
                </li>
                <li class="flex items-start gap-3 text-sm text-[var(--vw-text-secondary)]">
                    <i data-lucide="check" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--vw-success)]"></i>
                    Small teams — most squads are 4-6 people, so your work is visible.
                </li>
            </ul>
        </div>
        <div class="vw-hero relative aspect-square rounded-2xl sm:aspect-[4/3]" role="img" aria-label="Abstract gradient pattern representing VISTAWAYS TECH's collaborative culture">
            <div class="absolute inset-0 flex items-center justify-center">
                <i data-lucide="users" class="h-16 w-16 text-white/25"></i>
            </div>
        </div>
    </div>
</section>

@* ================================================================
   TESTIMONIALS — secondary section: supporting/social proof, sits
   right before the hiring-process walkthrough and final CTA.
   ================================================================ *@
<section class="py-16 border-t border-[var(--vw-border)] scroll-mt-20">
    <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-2xl font-bold tracking-tight text-[var(--vw-text)] sm:text-3xl">What it's actually like</h2>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-3">
        @{
            var quotes = new (string Initials, string Name, string Role, string Quote)[] {
                ("AR", "Ananya R.", "Backend Engineer, 2 yrs", "The assessment was the first hiring process I've done where I felt like I was being evaluated on the actual job, not a trivia round."),
                ("SK", "Suresh K.", "QA Lead, 4 yrs", "I moved from manual testing into leading our automation strategy in under two years — the path was clear from the day I started."),
                ("MP", "Meera P.", "Recruiter, 1 yr", "Being on the other side of this exact pipeline now, I still think it's the most honest hiring flow I've worked with."),
            };
        }
        @foreach (var q in quotes)
        {
            <figure class="vw-testimonial-card">
                <i data-lucide="quote" class="h-5 w-5 text-[var(--vw-border-strong)]"></i>
                <blockquote class="mt-3 text-sm text-[var(--vw-text-secondary)]">&ldquo;@q.Quote&rdquo;</blockquote>
                <figcaption class="mt-5 flex items-center gap-3">
                    <span class="vw-testimonial-avatar">@q.Initials</span>
                    <span>
                        <span class="block text-sm font-semibold text-[var(--vw-text)]">@q.Name</span>
                        <span class="block text-xs text-[var(--vw-text-muted)]">@q.Role</span>
                    </span>
                </figcaption>
            </figure>
        }
    </div>
</section>

@* ================================================================
   LOCATIONS — secondary section. Uses the real registered office
   address from Views/Site/ContactUs.cshtml; doesn't invent any other
   office locations that aren't confirmed elsewhere in the app.
   ================================================================ *@
<section id="locations" class="py-16 border-t border-[var(--vw-border)] scroll-mt-20">
    <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-2xl font-bold tracking-tight text-[var(--vw-text)] sm:text-3xl">Locations</h2>
    </div>
    <div class="mx-auto mt-10 max-w-md">
        <div class="vw-feature-card flex items-start gap-4">
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-[var(--vw-accent-bg)] text-[var(--vw-accent-text)]">
                <i data-lucide="map-pin" class="h-5 w-5"></i>
            </div>
            <div>
                <h3 class="font-semibold text-[var(--vw-text)]">Hyderabad HQ</h3>
                <p class="mt-1 text-sm text-[var(--vw-text-secondary)]">Manjeera Majestic Commercial, 621, Kukatpally, Telangana 500072</p>
            </div>
        </div>
        <p class="mt-6 text-center text-sm text-[var(--vw-text-muted)]">Growing team — remote and hybrid roles open across India depending on the position.</p>
    </div>
</section>

</div>

@* ================================================================
   FINAL CTA
   ================================================================ *@
<section class="vw-hero mt-8">
    <div class="mx-auto max-w-2xl px-4 py-20 text-center sm:px-6">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Ready to see how you measure up?</h2>
        <p class="mt-4 text-slate-300">Registration takes five minutes. The assessment, when you're invited, takes the rest of the conversation.</p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a asp-controller="Account" asp-action="Register" class="ui-btn-primary w-full px-7 py-3 text-base sm:w-auto">
                <i data-lucide="user-plus" class="h-4 w-4"></i>Create an account
            </a>
            <a asp-controller="Account" asp-action="Login" class="w-full rounded-lg border border-white/25 px-7 py-3 text-base font-semibold text-white transition-colors hover:bg-white/10 sm:w-auto text-center">
                Sign in
            </a>
        </div>
    </div>
</section>

@section Scripts {
    @* Filters the static #jobsGrid cards in the browser — see the note by
       the filter bar above on why this isn't a server-side search. Scoped
       to this page only; doesn't touch app.js or any shared behavior. *@
    <script>
        (function () {
            "use strict";
            var searchInput = document.getElementById("jobSearchInput");
            var deptFilter = document.getElementById("jobDeptFilter");
            var typeFilter = document.getElementById("jobTypeFilter");
            var grid = document.getElementById("jobsGrid");
            var emptyState = document.getElementById("jobsEmptyState");
            if (!searchInput || !deptFilter || !typeFilter || !grid) return;

            var cards = Array.prototype.slice.call(grid.querySelectorAll("[data-job-title]"));

            function applyFilters() {
                var query = searchInput.value.trim().toLowerCase();
                var dept = deptFilter.value;
                var type = typeFilter.value;
                var visibleCount = 0;

                cards.forEach(function (card) {
                    var matchesQuery = !query
                        || card.getAttribute("data-job-title").indexOf(query) !== -1
                        || card.getAttribute("data-job-location").indexOf(query) !== -1;
                    var matchesDept = !dept || card.getAttribute("data-job-dept") === dept;
                    var matchesType = !type || card.getAttribute("data-job-type") === type;
                    var visible = matchesQuery && matchesDept && matchesType;
                    card.classList.toggle("hidden", !visible);
                    if (visible) visibleCount++;
                });

                if (emptyState) emptyState.classList.toggle("hidden", visibleCount !== 0);
            }

            searchInput.addEventListener("input", applyFilters);
            deptFilter.addEventListener("change", applyFilters);
            typeFilter.addEventListener("change", applyFilters);
        })();
    </script>
}

@{
    ViewData["Title"] = "Cookie Policy";
}
<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">Cookie Policy</h1>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Last updated: August 12, 2026</p>

    <div class="mt-8 space-y-6 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
        <p>This site uses a small number of first-party cookies, all functional/essential —
            there is no advertising or third-party tracking cookie on this site.</p>

        <div class="overflow-x-auto">
            <table class="ui-table w-full">
                <thead>
                    <tr><th>Cookie</th><th>Purpose</th><th>Duration</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="font-mono text-xs">.AspNetCore.Cookies</td>
                        <td>Keeps you signed in. Lasts 4 hours normally, or 30 days if you check
                            "Remember me" at login.</td>
                        <td>Session / 30 days</td>
                    </tr>
                    <tr>
                        <td class="font-mono text-xs">VWT.ExternalGoogle</td>
                        <td>Short-lived cookie used only during the "Continue with Google" sign-in
                            redirect, to securely complete the handoff back from Google.</td>
                        <td>10 minutes</td>
                    </tr>
                    <tr>
                        <td class="font-mono text-xs">vwt_cookie_consent</td>
                        <td>Remembers that you've dismissed the cookie notice, so it doesn't show
                            again on your next visit.</td>
                        <td>1 year</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <section>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Managing cookies</h2>
            <p class="mt-2">Since every cookie here is functional/essential (needed to keep
                you signed in or to complete a sign-in redirect), there isn't a
                preference toggle for them — blocking them in your browser will simply
                prevent sign-in from working. You can still clear them at any time via
                your browser's settings.</p>
        </section>
        <section>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Contact</h2>
            <p class="mt-2">Questions can be sent via our <a asp-action="ContactUs" class="font-semibold text-[var(--vw-accent)] hover:underline">Contact Us</a> page.</p>
        </section>
    </div>
</div>

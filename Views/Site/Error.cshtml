@{
    ViewData["Title"] = "Something went wrong";
}

<div class="mx-auto max-w-xl px-4 py-20 text-center sm:px-6">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[var(--vw-danger-bg)] text-[var(--vw-danger-text)]">
        <i data-lucide="triangle-alert" class="h-6 w-6"></i>
    </div>
    <h1 class="mt-6 text-2xl font-bold tracking-tight text-[var(--vw-text)] sm:text-3xl">Something went wrong on our end</h1>
    <p class="mt-3 text-[var(--vw-text-secondary)]">
        That wasn't supposed to happen. Nothing you did caused this — please try again in a moment,
        or head back to somewhere familiar.
    </p>
    @if (!string.IsNullOrEmpty(ViewBag.RequestId as string))
    {
        <p class="mt-4 font-mono text-xs text-[var(--vw-text-muted)]">Reference: @ViewBag.RequestId</p>
    }
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a asp-controller="Site" asp-action="Index" class="ui-btn-primary w-full px-6 py-2.5 sm:w-auto">
            <i data-lucide="home" class="h-4 w-4"></i>Back to home
        </a>
        <a href="javascript:history.back()" class="w-full rounded-lg border border-[var(--vw-border)] px-6 py-2.5 text-sm font-semibold text-[var(--vw-text)] transition-colors hover:bg-[var(--vw-surface-muted)] sm:w-auto">
            Go back
        </a>
    </div>
</div>

@{
    ViewData["Title"] = "About Us";
}
<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">About VISTAWAYS TECH</h1>

    <div class="mt-8 space-y-6 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
        <p>At Vistaways Tech, we are more than just a technology company — we are a team of
            innovators, problem-solvers, and business enablers. We combine innovation,
            expertise, and technology to deliver solutions that drive growth and efficiency
            for businesses worldwide. Our mission is to empower organizations with customized
            IT solutions that solve real-world challenges and unlock new opportunities.</p>

        <section>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Who we are</h2>
            <p class="mt-2">We are a trusted technology partner, offering end-to-end services
                across Software Development, Staffing, Cloud Solutions, Embedded Systems,
                Banking &amp; Financial Solutions, Mechanical Engineering Services, and BPO
                Services. With a team of highly skilled professionals and a client-first
                approach, we focus on delivering measurable results.</p>
        </section>

        <section>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white">Why partner with us</h2>
            <ul class="mt-2 list-disc space-y-1 pl-5">
                <li><strong>End-to-End Solutions</strong> — from ideation to deployment, we cover all your business needs.</li>
                <li><strong>Global Expertise</strong> — experience across diverse industries and international markets.</li>
                <li><strong>Innovation First</strong> — always leveraging the latest technologies for your advantage.</li>
                <li><strong>Scalability &amp; Security</strong> — solutions designed to grow with your business securely.</li>
                <li><strong>Client-Centric Approach</strong> — we succeed when our clients succeed.</li>
            </ul>
        </section>

        <section>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white">How ExamPortal fits in</h2>
            <p class="mt-2">ExamPortal is the platform behind our hiring pipeline — every
                candidate goes through a transparent, skills-first process: a live assessment
                and a reviewed evaluation, rather than being judged on a resume alone.</p>
        </section>

        <p class="text-xs text-slate-400 dark:text-slate-500">More at <a href="https://vistawaystech.com" target="_blank" rel="noopener" class="font-semibold text-[var(--vw-accent)] hover:underline">vistawaystech.com</a>.</p>
    </div>
</div>

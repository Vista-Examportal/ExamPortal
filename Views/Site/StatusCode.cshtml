@{
    ViewData["Title"] = ViewBag.Title as string ?? "Something went wrong";
    int code = ViewBag.Code as int? ?? 0;
    string icon = code switch
    {
        404 => "map-pin-off",
        403 => "shield-alert",
        _ => "triangle-alert",
    };
}

<div class="mx-auto max-w-xl px-4 py-20 text-center sm:px-6">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[var(--vw-danger-bg)] text-[var(--vw-danger-text)]">
        <i data-lucide="@icon" class="h-6 w-6"></i>
    </div>
    @if (code > 0)
    {
        <p class="mt-5 font-mono text-xs font-semibold tracking-wide text-[var(--vw-text-muted)]">ERROR @code</p>
    }
    <h1 class="mt-2 text-2xl font-bold tracking-tight text-[var(--vw-text)] sm:text-3xl">@ViewBag.Title</h1>
    <p class="mt-3 text-[var(--vw-text-secondary)]">@ViewBag.Message</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a asp-controller="Site" asp-action="Index" class="ui-btn-primary w-full px-6 py-2.5 sm:w-auto">
            <i data-lucide="home" class="h-4 w-4"></i>Back to home
        </a>
        <a href="javascript:history.back()" class="w-full rounded-lg border border-[var(--vw-border)] px-6 py-2.5 text-sm font-semibold text-[var(--vw-text)] transition-colors hover:bg-[var(--vw-surface-muted)] sm:w-auto">
            Go back
        </a>
    </div>
</div>

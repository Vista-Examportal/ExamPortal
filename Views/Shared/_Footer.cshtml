@{
    var year = DateTime.UtcNow.Year;
}
<footer class="border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
        <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
            <div class="col-span-2 sm:col-span-1">
                <img src="~/logo-full-light.png" alt="VISTAWAYS TECH — Innovation. Integration. Impact." class="app-topbar-logo-light h-10 w-auto object-contain" width="2047" height="561" />
                <img src="~/logo-full.png" alt="VISTAWAYS TECH — Innovation. Integration. Impact." class="app-topbar-logo-dark h-10 w-auto object-contain" width="2047" height="561" />
            </div>
            <div>
                <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Company</h3>
                <ul class="mt-3 space-y-2 text-sm">
                    <li><a asp-controller="Site" asp-action="AboutUs" class="text-slate-600 hover:text-[var(--vw-accent)] hover:underline dark:text-slate-300">About Us</a></li>
                    <li><a asp-controller="Site" asp-action="ContactUs" class="text-slate-600 hover:text-[var(--vw-accent)] hover:underline dark:text-slate-300">Contact Us</a></li>
                    <li><a asp-controller="Account" asp-action="Register" class="text-slate-600 hover:text-[var(--vw-accent)] hover:underline dark:text-slate-300">Careers</a></li>
                </ul>
            </div>
            <div>
                <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Legal</h3>
                <ul class="mt-3 space-y-2 text-sm">
                    <li><a asp-controller="Site" asp-action="PrivacyPolicy" class="text-slate-600 hover:text-[var(--vw-accent)] hover:underline dark:text-slate-300">Privacy Policy</a></li>
                    <li><a asp-controller="Site" asp-action="TermsOfService" class="text-slate-600 hover:text-[var(--vw-accent)] hover:underline dark:text-slate-300">Terms of Service</a></li>
                    <li><a asp-controller="Site" asp-action="CookiePolicy" class="text-slate-600 hover:text-[var(--vw-accent)] hover:underline dark:text-slate-300">Cookie Policy</a></li>
                </ul>
            </div>
            <div>
                <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Support</h3>
                <ul class="mt-3 space-y-2 text-sm">
                    <li><a asp-controller="Site" asp-action="AccessibilityStatement" class="text-slate-600 hover:text-[var(--vw-accent)] hover:underline dark:text-slate-300">Accessibility</a></li>
                    <li><a asp-controller="Account" asp-action="Login" class="text-slate-600 hover:text-[var(--vw-accent)] hover:underline dark:text-slate-300">Sign In</a></li>
                </ul>
            </div>
        </div>
        <div class="mt-10 border-t border-slate-200 pt-6 text-xs text-slate-400 dark:border-slate-800 dark:text-slate-500">
            © @year Vistawaystech LLP. All rights reserved.
        </div>
    </div>
</footer>

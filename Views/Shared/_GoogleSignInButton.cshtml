@model string
@inject ExamPortal.Models.GoogleSignInStatus GoogleSignInStatus
@inject Microsoft.Extensions.Options.IOptions<ExamPortal.Configuration.GoogleAuthOptions> GoogleAuthOptionsAccessor
@{
    // Model is the button label: "Continue with Google" (Login) or "Sign up with Google"
    // (Register). Both use Google Identity Services (GIS) — see
    // AccountController.ExternalAuth.cs GoogleLogin(string credential) for what happens
    // server-side once GIS hands this page a signed Google ID token; whether the Google
    // account turns out to be a new signup or an existing candidate logging back in is
    // resolved server-side there, not by which page the button was clicked from.
    var label = Model ?? "Continue with Google";
    // ClientId is a public identifier (it's meant to be embedded in client-side code —
    // that's how every Google Identity Services integration works) — never the secret.
    // GoogleAuthOptions.ClientSecret is never read here or sent to the browser.
    var clientId = GoogleAuthOptionsAccessor.Value.ClientId;
    var buttonText = string.Equals(Model, "Sign up with Google", StringComparison.Ordinal) ? "signup_with" : "signin_with";
}
@if (GoogleSignInStatus.IsConfigured)
{
    <div class="my-5 flex items-center gap-3" role="separator" aria-label="or">
        <div class="h-px flex-1 bg-slate-200 dark:bg-slate-700"></div>
        <span class="shrink-0 text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Or</span>
        <div class="h-px flex-1 bg-slate-200 dark:bg-slate-700"></div>
    </div>

    @* GIS renders its own official Google button into this element — see the script
       below. aria-label keeps a sensible accessible name before GIS finishes loading. *@
    <div id="googleSignInButton" class="flex w-full justify-center" aria-label="@label"></div>

    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <script>
        (function () {
            // GIS's client-side callback: receives the signed Google ID token ("credential")
            // and POSTs it to the existing GoogleLogin(string credential) action, reusing the
            // same antiforgery-token pattern Views/Exam/Take.cshtml's AJAX calls already use
            // (Program.cs applies AutoValidateAntiforgeryTokenAttribute globally to every
            // POST, so this token is required, not optional). A normal, full browser
            // navigation to whatever URL the server redirects to afterward — success
            // (dashboard/next onboarding step) and failure (back to Login with a TempData
            // error) both flow through the exact same redirects GoogleCallback always used.
            function handleCredentialResponse(response) {
                var csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                var body = new URLSearchParams({ credential: response.credential, __RequestVerificationToken: csrfToken });
                fetch('/Account/GoogleLogin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: body
                }).then(function (res) {
                    window.location.href = res.url;
                }).catch(function () {
                    window.location.href = '/Account/Login';
                });
            }

            function initGoogleButton() {
                if (!window.google || !google.accounts || !google.accounts.id) return;
                google.accounts.id.initialize({
                    client_id: '@clientId',
                    callback: handleCredentialResponse
                });
                google.accounts.id.renderButton(
                    document.getElementById('googleSignInButton'),
                    { theme: 'outline', size: 'large', width: 320, text: '@buttonText' }
                );
            }

            if (document.readyState === 'complete') {
                initGoogleButton();
            } else {
                window.addEventListener('load', initGoogleButton);
            }
        })();
    </script>
}

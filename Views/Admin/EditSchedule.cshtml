@model EditExamScheduleViewModel
@{ ViewData["Title"] = "Edit Assessment Schedule"; }

<div class="vw-page-header">
    <div class="vw-page-header-main">
        <div class="vw-page-header-icon"><i data-lucide="calendar-clock"></i></div>
        <div>
            <h1 class="vw-page-title">Edit Schedule</h1>
            <p class="text-sm text-slate-500 dark:text-slate-400">@Model.Title</p>
        </div>
    </div>
    <div class="vw-page-actions">
        @if (!User.IsInRole(PortalRoles.Admin) && User.IsInRole(PortalRoles.Recruiter))
        {
            <a asp-controller="Recruiter" asp-action="Index" asp-route-tab="assessments" class="ui-btn-outline"><i data-lucide="arrow-left" class="h-4 w-4"></i>Back</a>
        }
        else
        {
            <a asp-action="Index" class="ui-btn-outline"><i data-lucide="arrow-left" class="h-4 w-4"></i>Back</a>
        }
    </div>
</div>

<div class="mx-auto max-w-xl">
    <div class="ui-card">
        <div class="ui-card-body">
            <form asp-action="EditSchedule" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Title" />

                <p class="mb-4 text-sm text-slate-500 dark:text-slate-400">
                    Reschedules or extends this assessment's open window — candidates can only start it
                    while the current time falls between Start and End (and Status is Active or Scheduled).
                    This doesn't touch existing attempts, results, or questions.
                </p>

                <div class="grid grid-cols-12 gap-3">
                    <div class="col-span-6"><label for="StartDateTime" class="ui-label">Start</label><input asp-for="StartDateTime" class="ui-field" /></div>
                    <div class="col-span-6"><label for="EndDateTime" class="ui-label">End</label><input asp-for="EndDateTime" class="ui-field" /></div>
                    <div class="col-span-12">
                        <label for="TimeZone" class="ui-label">Time Zone for Start/End</label>
                        <select asp-for="TimeZone" class="ui-field">
                            @await Html.PartialAsync("_TimeZoneOptions")
                        </select>
                        <div class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">
                            The assessment doesn't remember which zone it was originally scheduled in —
                            double-check Start/End above are showing the time you expect before saving.
                        </div>
                    </div>
                    <div class="col-span-12">
                        <label for="Status" class="ui-label">Status</label>
                        <select asp-for="Status" class="ui-field">
                            <option>Draft</option>
                            <option>Scheduled</option>
                            <option>Active</option>
                            <option>Closed</option>
                        </select>
                    </div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="ui-alert-danger mt-3" role="alert" aria-live="assertive">
                        <div class="ui-alert-icon"><i data-lucide="circle-alert" class="h-4 w-4"></i></div>
                        <div>@Html.ValidationSummary(false, null, new { @class = "space-y-0.5" })</div>
                    </div>
                }

                <button type="submit" class="ui-btn-primary mt-5 w-full py-2.5 font-semibold">
                    <i data-lucide="save" class="h-4 w-4"></i>Save Schedule
                </button>
            </form>
        </div>
    </div>
</div>

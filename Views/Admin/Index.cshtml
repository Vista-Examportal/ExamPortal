            <div class="ui-card-header"><h2 class="ui-heading-sm">Email Templates</h2></div>
            <ul class="divide-y divide-slate-100 text-sm text-slate-600 dark:divide-slate-700 dark:text-slate-300">
                <li class="px-5 py-2.5">Candidate Registration OTP</li>
                <li class="px-5 py-2.5">Assessment Invitation</li>
                <li class="px-5 py-2.5">Interview Schedule</li>
                <li class="px-5 py-2.5">Document Request</li>
                <li class="px-5 py-2.5">Offer Letter</li>
            </ul>
        </div>
        <div class="ui-card">
            <div class="ui-card-header"><h2 class="ui-heading-sm">System Settings</h2></div>
            <div class="ui-card-body space-y-4">
                @if (!settings.Any())
                {
                    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Icon = "settings", Title = "No settings configured", Message = "System-wide settings will be listed here once added.", Compact = true })
                }
                @foreach (var setting in settings)
                {
                    <form asp-action="UpdateSystemSetting" method="post" class="space-y-1.5 border-b border-slate-100 pb-3 last:border-0 last:pb-0 dark:border-slate-700">
                        <input type="hidden" name="id" value="@setting.Id" />
                        <label class="ui-label !mb-0.5">@setting.Key</label>
                        <div class="flex gap-2">
                            <input name="value" value="@setting.Value" class="ui-field !py-1.5 text-sm" />
                            <button class="ui-btn-outline shrink-0 !px-3 !py-1.5 text-xs" type="submit" disabled="@(!isAdmin)">Update</button>
                        </div>
                        <div class="text-xs text-slate-500 dark:text-slate-400">@setting.Description</div>
                    </form>
                }
            </div>
        </div>
        <div class="ui-card">
            <div class="ui-card-header"><h2 class="ui-heading-sm">Audit Logs</h2></div>
            <ul class="max-h-96 divide-y divide-slate-100 overflow-y-auto dark:divide-slate-700">
                @if (!auditLogs.Any())
                {
                    <li>@await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Icon = "shield", Title = "No audit activity yet", Message = "A trail of admin actions will build up here over time.", Compact = true })</li>
                }
                @foreach (var log in auditLogs.Take(10))
                {
                    <li class="px-5 py-2.5">
                        <div class="text-sm font-medium text-slate-800 dark:text-slate-100">@log.Action <span class="font-normal text-slate-500 dark:text-slate-400">on @log.EntityName</span></div>
                        <div class="text-xs text-slate-500 dark:text-slate-400">@log.Actor &middot; @log.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</div>
                    </li>
                }
            </ul>
        </div>
        <div class="ui-card">
            <div class="ui-card-header"><h2 class="ui-heading-sm">Create Staff User</h2></div>
            <form asp-action="CreateStaffUser" method="post" class="ui-card-body space-y-3">
                <div><label class="ui-label">Full name<span class="ui-required">*</span></label><input name="fullName" class="ui-field" required /></div>
                <div><label class="ui-label">Email<span class="ui-required">*</span></label><input name="email" type="email" class="ui-field" required /></div>
                <div><label class="ui-label">Phone</label><input name="phone" class="ui-field" /></div>
                <div>
                    <label class="ui-label">Role</label>
                    <select name="role" class="ui-field">
                        <option value="@PortalRoles.Recruiter">Recruiter</option>
                        <option value="@PortalRoles.Hr">HR</option>
                        <option value="@PortalRoles.Admin">Admin</option>
                    </select>
                </div>
                <div>
                    <label class="ui-label" for="staffTempPassword">Temporary password<span class="ui-required">*</span></label>
                    <div class="relative">
                        <input id="staffTempPassword" name="password" type="password" minlength="8" class="ui-field pr-10" required data-pw-strength="staffPwStrength" />
                        <button type="button" class="pw-toggle-inline" data-pw-toggle="staffTempPassword" aria-label="Show password">
                            <i data-lucide="eye" class="h-4 w-4"></i>
                        </button>
                    </div>
                    <div id="staffPwStrength" class="pw-strength" aria-live="polite">
                        <div class="pw-strength-track">
                            <div class="pw-strength-seg"></div>
                            <div class="pw-strength-seg"></div>
                            <div class="pw-strength-seg"></div>
                            <div class="pw-strength-seg"></div>
                        </div>
                        <span class="pw-strength-label"></span>
                    </div>
                </div>
                <button class="ui-btn-primary w-full" type="submit" disabled="@(!isAdmin)"><i data-lucide="user-plus" class="h-4 w-4"></i>Create</button>
            </form>
        </div>
    </section>

    @* ===================== Analytics tab ===================== *@
    <section data-tabs-panel="analytics" data-tabs-group="admin-dash" class="hidden grid gap-6 md:grid-cols-2">
        <div class="ui-card">
            <div class="ui-card-header"><h2 class="ui-heading-sm">Reports</h2></div>
            <div class="overflow-x-auto">
                <table class="ui-table">
                    <thead class="border-b border-slate-100 text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400 dark:border-slate-700">
                        <tr><th class="px-5 py-2.5 font-medium">Assessment</th><th class="px-5 py-2.5 font-medium">Invited</th><th class="px-5 py-2.5 font-medium">Completed</th><th class="px-5 py-2.5 font-medium">Average</th></tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @if (!reports.Any())
                        {
                            <tr><td colspan="4" class="p-0">@await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Icon = "bar-chart-3", Title = "No reports generated yet", Message = "Reports appear once candidates start completing assessments.", Compact = true })</td></tr>
                        }
                        @foreach (var report in reports)
                        {
                            <tr>
                                <td class="px-5 py-2.5 text-slate-700 dark:text-slate-200">@report.Exam?.Title</td>
                                <td class="px-5 py-2.5 text-slate-500 dark:text-slate-400">@report.InvitedCandidates</td>
                                <td class="px-5 py-2.5 text-slate-500 dark:text-slate-400">@report.CompletedAttempts</td>
                                <td class="px-5 py-2.5 text-slate-500 dark:text-slate-400">@report.AverageScore.ToString("0.##")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="ui-card">
            <div class="ui-card-header"><h2 class="ui-heading-sm">Notifications and Proctoring</h2></div>
            <div class="ui-card-body space-y-4">
                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                    <div class="rounded-lg bg-slate-50 p-3 dark:bg-slate-700/40">
                        <div class="text-xs text-slate-500 dark:text-slate-400">Notification History</div>
                        <div class="text-xl font-bold text-slate-800 dark:text-slate-100">@notifications.Count()</div>
                    </div>
                    <div class="rounded-lg bg-slate-50 p-3 dark:bg-slate-700/40">
                        <div class="text-xs text-slate-500 dark:text-slate-400">Recent Suspicious Logs</div>
                        <div class="text-xl font-bold text-slate-800 dark:text-slate-100">@proctoringLogs.Count()</div>
                    </div>
                </div>

                <div class="flex items-center justify-between border-t border-slate-100 pt-3 dark:border-slate-700">
                    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">Recent Notifications</span>
                    <form asp-action="RetryFailedNotifications" method="post">
                        <button class="ui-btn-outline !px-3 !py-1.5 text-xs"
                                data-confirm-title="Retry all failed notifications?"
                                data-confirm-message="This re-queues every notification currently marked as Failed.">Retry Failed</button>
                    </form>
                </div>
                <ul class="max-h-64 divide-y divide-slate-100 overflow-y-auto text-sm dark:divide-slate-700">
                    @foreach (var note in notifications.Take(8))
                    {
                        <li class="flex items-start justify-between gap-3 py-2.5">
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2 font-medium text-slate-800 dark:text-slate-100">
                                    @note.Subject <span class="ui-badge-neutral">@note.Channel</span>
                                </div>
                                <div class="text-xs text-slate-500 dark:text-slate-400">@note.User?.FullName &middot; retries @note.RetryCount/@note.MaxRetries</div>
                                @if (!string.IsNullOrWhiteSpace(note.ErrorMessage))
                                {
                                    <div class="text-xs text-red-500 dark:text-red-400">@note.ErrorMessage</div>
                                }
                            </div>
                            <div class="shrink-0 text-right">
                                <span class="@(note.Status == "Sent" ? "ui-badge-success" : note.Status == "Failed" ? "ui-badge-danger" : "ui-badge-warning")">@note.Status</span>
                                @if (note.Status == "Failed")
                                {
                                    <form asp-action="RetryFailedNotifications" method="post" class="mt-1">
                                        <input type="hidden" name="notificationId" value="@note.Id" />
                                        <button class="ui-btn-outline !px-2.5 !py-1 text-xs">Retry</button>
                                    </form>
                                }
                            </div>
                        </li>
                    }
                </ul>

                <div class="border-t border-slate-100 pt-3 dark:border-slate-700">
                    <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">Proctoring Flags</span>
                    <ul class="mt-2 max-h-56 divide-y divide-slate-100 overflow-y-auto text-sm dark:divide-slate-700">
                        @if (!proctoringLogs.Any())
                        {
                            <li>@await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Icon = "shield-check", Title = "No proctoring flags", Message = "Nothing suspicious detected during monitored attempts.", Variant = "success", Compact = true })</li>
                        }
                        @foreach (var log in proctoringLogs.Take(8))
                        {
                            <li class="flex items-center justify-between py-2">
                                <span class="text-slate-600 dark:text-slate-300">@log.EventType &middot; @log.Attempt?.User?.FullName</span>
                                <span class="text-xs text-slate-500 dark:text-slate-400">@log.OccurredAt.ToLocalTime().ToString("HH:mm")</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        // Stat cards use the shared data-skeleton wiring in app.js (same brief,
        // deliberate loading state as before). Once it reveals them, restart the
        // count-up animation now that the numbers are actually visible.
        document.addEventListener('vw:skeleton-revealed', function (e) {
            if (e.detail.group === 'admin-stats' && window.vwInitStatCounters) window.vwInitStatCounters();
        });
    </script>
}

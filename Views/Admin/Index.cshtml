    @* ===================== Jobs tab ===================== *@
    @* There's no separate Job/requisition entity in this app — recruiting here
       is assessment-centric. Rather than re-listing the same Model.Exams rows
       shown in the Assessments tab with different column labels (which was
       pure duplication of the same data), this rolls exams up by Subject —
       the closest proxy to "role" on the Exam model — into one row per role,
       aggregating the skills/locations/experience already on each exam and
       showing how many assessments and how many are currently open for that
       role. All computed view-locally from Model.Exams; no new data needed. *@
    <section data-tabs-panel="jobs" data-tabs-group="admin-dash" class="hidden">
        @{
            var roleGroups = Model.Exams
                .GroupBy(e => string.IsNullOrWhiteSpace(e.Subject) ? "Unspecified" : e.Subject)
                .Select(g => new
                {
                    Role = g.Key,
                    TotalAssessments = g.Count(),
                    OpenAssessments = g.Count(e => e.IsActive),
                    Skills = string.Join(", ", g.Select(e => e.RequiredSkills).Where(s => !string.IsNullOrWhiteSpace(s)).SelectMany(s => s.Split(',')).Select(s => s.Trim()).Where(s => s.Length > 0).Distinct()),
                    Locations = string.Join(", ", g.Select(e => e.EligibleLocations).Where(s => !string.IsNullOrWhiteSpace(s)).SelectMany(s => s.Split(',')).Select(s => s.Trim()).Where(s => s.Length > 0).Distinct()),
                    Experience = string.Join(", ", g.Select(e => e.ExperienceLevel).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct())
                })
                .OrderByDescending(r => r.OpenAssessments)
                .ToList();
        }
        <div class="ui-card">
            <div class="overflow-x-auto">
                <table class="ui-table">
                    <thead class="border-b border-slate-100 text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400 dark:border-slate-700">
                        <tr><th class="px-5 py-3 font-medium">Role</th><th class="px-5 py-3 font-medium">Skills</th><th class="px-5 py-3 font-medium">Locations</th><th class="px-5 py-3 font-medium">Experience</th><th class="px-5 py-3 font-medium">Open / Total Assessments</th></tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @if (!roleGroups.Any())
                        {
                            <tr><td colspan="5" class="p-0">@await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Icon = "briefcase", Title = "No roles configured yet", Message = "Create an assessment to open a role for candidates.", Variant = "accent", ActionText = "Create Assessment", ActionUrl = Url.Action("CreateExam"), ActionIcon = "plus", Compact = true })</td></tr>
                        }
                        @foreach (var role in roleGroups)
                        {
                            <tr>
                                <td class="px-5 py-3 font-semibold text-slate-800 dark:text-slate-100">@role.Role</td>
                                <td class="px-5 py-3 text-xs text-slate-500 dark:text-slate-400" style="max-width:240px;">@role.Skills</td>
                                <td class="px-5 py-3 text-slate-500 dark:text-slate-400">@role.Locations</td>
                                <td class="px-5 py-3 text-slate-500 dark:text-slate-400">@role.Experience</td>
                                <td class="px-5 py-3">
                                    <span class="@(role.OpenAssessments > 0 ? "ui-badge-success" : "ui-badge-neutral")">@role.OpenAssessments / @role.TotalAssessments</span>
                                    <button type="button" class="ui-btn-ghost ml-2 !px-0 !py-0 text-xs" onclick="window.vwActivateTab('admin-dash','assessments')">View assessments →</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>


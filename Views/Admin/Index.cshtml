@using ExamPortal.Models
@using System.Text.RegularExpressions
@using System.Globalization
@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    var staffUsers = (IEnumerable<User>)(ViewBag.StaffUsers ?? new List<User>());
    var recruiters = (IEnumerable<User>)(ViewBag.Recruiters ?? new List<User>());
    var hrStaff = staffUsers.Where(u => u.Role == PortalRoles.Hr).ToList();
    var candidates = (IEnumerable<User>)(ViewBag.Candidates ?? new List<User>());
    var interviews = (IEnumerable<InterviewRecord>)(ViewBag.Interviews ?? new List<InterviewRecord>());
    var offers = (IEnumerable<OfferLetter>)(ViewBag.Offers ?? new List<OfferLetter>());
    var auditLogs = (IEnumerable<AuditLog>)(ViewBag.AuditLogs ?? new List<AuditLog>());
    var settings = (IEnumerable<SystemSetting>)(ViewBag.SystemSettings ?? new List<SystemSetting>());
    var notifications = (IEnumerable<NotificationMessage>)(ViewBag.Notifications ?? new List<NotificationMessage>());
    var reports = (IEnumerable<AssessmentReport>)(ViewBag.Reports ?? new List<AssessmentReport>());
    var proctoringLogs = (IEnumerable<ProctoringLog>)(ViewBag.ProctoringLogs ?? new List<ProctoringLog>());
    var pipelineCounts = ViewBag.PipelineCounts as IDictionary<string, int> ?? new Dictionary<string, int>();
    var roles = new[] { PortalRoles.Admin, PortalRoles.Recruiter, PortalRoles.Hr, PortalRoles.Candidate };
    var isAdmin = User.IsInRole(PortalRoles.Admin);

    var activeInvitations = (int)(ViewBag.ActiveInvitations ?? 0);
    var averageScore = (decimal)(ViewBag.AverageScore ?? 0m);
    var shortlistedCount = (int)(ViewBag.ShortlistedCount ?? 0);
    var averageScoreStr = averageScore.ToString("0.0", CultureInfo.InvariantCulture);
    var pendingOffersCount = (int)(ViewBag.PendingOffersCount ?? 0);
    var monthlyHiredCount = (int)(ViewBag.MonthlyHiredCount ?? 0);
    var totalAuditLogsCount = (int)(ViewBag.TotalAuditLogsCount ?? 0);
    var activeJobsCount = Model.Exams.Where(e => e.IsActive && !e.IsTemplate)
        .Select(e => string.IsNullOrWhiteSpace(e.Subject) ? "Unspecified" : e.Subject)
        .Distinct().Count();

    // ── Candidate summary data (view-only aggregation of data the page
    // already receives via Model/ViewBag — no controller/service change) ──
    Func<string, int> stageCount = s => pipelineCounts.TryGetValue(s, out var v) ? v : 0;
    var onboardingCount = stageCount("Onboarding");
    var upcomingExams = Model.Exams
        .Where(e => e.StartDateTime.HasValue && e.StartDateTime.Value > DateTime.UtcNow)
        .OrderBy(e => e.StartDateTime)
        .Take(5)
        .ToList();

    // Shared with Admin/Pipeline.cshtml via RecruitmentStages.FriendlyLabel (was previously
    // a copy-pasted local regex here).
    Func<string, string> friendlyLabel = RecruitmentStages.FriendlyLabel;

    Func<string, string> auditIcon = action =>
    {
        var a = (action ?? "").ToLowerInvariant();
        if (a.Contains("create") || a.Contains("add") || a.Contains("issue")) return "circle-plus";
        if (a.Contains("delete") || a.Contains("remove") || a.Contains("revoke")) return "trash-2";
        if (a.Contains("update") || a.Contains("edit") || a.Contains("change")) return "pencil";
        if (a.Contains("login") || a.Contains("auth")) return "log-in";
        return "activity";
    };

    // Shared color->CSS-class mapping (UiBadge.StageCssClass) — was previously copy-pasted here.
    Func<string, string> stageBadgeClass = ExamPortal.Models.UiBadge.StageCssClass;

    // Dashboard pipeline widget shows a curated subset of stages — the
    // intake/paperwork sub-steps (email verification, profile/resume/skill
    // completion, document requests) are real and still fully tracked
    // everywhere else (Pipeline board, Candidates tab; RecruitmentStages
    // itself is unchanged), just collapsed out of this one summary view so
    // it reads as 8 funnel stages instead of 16. Offer is shown as a single
    // combined stage (Issued + Accepted) to match; nothing here changes how
    // candidates are actually staged.
    var dashboardPipelineStages = new (string Label, int Count)[]
    {
        ("Registered", stageCount(RecruitmentStages.Registered)),
        ("Invitation Sent", stageCount(RecruitmentStages.InvitationSent)),
        ("Assessment Started", stageCount(RecruitmentStages.AssessmentStarted)),
        ("Assessment Completed", stageCount(RecruitmentStages.AssessmentCompleted)),
        ("Shortlisted", stageCount(RecruitmentStages.Shortlisted)),
        ("Interview", stageCount(RecruitmentStages.InterviewInProgress)),
        ("Offer", stageCount(RecruitmentStages.OfferIssued) + stageCount(RecruitmentStages.OfferAccepted)),
        ("Onboarding", stageCount(RecruitmentStages.Onboarding)),
    };
    var dashboardPipelineMax = dashboardPipelineStages.Select(s => s.Count).DefaultIfEmpty(0).Max();
    var dashboardPipelineTotal = dashboardPipelineStages.Sum(s => s.Count);
    // Admin-only Recent Activity (platform administration events only — staff/role/
    // system-setting changes). Built by ActivityFeedService.BuildAdminFeed, which
    // filters AuditLogs down to an admin-action allowlist so candidate/exam entries
    // written by AuditService elsewhere (e.g. "Start Assessment") never show up here.
    var recentActivity = Model.ActivityFeed;
    var adminAlerts = Model.Alerts;
}

<div class="mx-auto max-w-7xl space-y-6">

    @* ===================== Header ===================== *@
    <div class="vw-page-header !mb-0">
        <div class="vw-page-header-main">
            <div class="vw-page-header-icon"><i data-lucide="shield-check"></i></div>
            <div>
                <h1 class="vw-page-title no-icon">Admin Dashboard</h1>
                <p class="vw-page-subtitle">Enterprise recruitment operations, access control, audit, and analytics.</p>
            </div>
        </div>
        <div class="vw-page-actions">
            <a asp-action="Pipeline" class="ui-btn-secondary"><i data-lucide="git-branch" class="h-4 w-4"></i>Pipeline</a>
            <a asp-action="Students" class="ui-btn-outline"><i data-lucide="users" class="h-4 w-4"></i>Candidates</a>
            <a asp-action="CreateExam" class="ui-btn-primary"><i data-lucide="circle-plus" class="h-4 w-4"></i>New Assessment</a>
        </div>
    </div>

    @* ===================== Stat cards (with a brief skeleton loading state) ===================== *@
    <div data-skeleton="admin-stats" class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        @for (int i = 0; i < 4; i++)
        {
            <div class="ui-card flex items-center gap-3 p-4">
                <div class="ui-skeleton h-11 w-11 shrink-0 rounded-lg"></div>
                <div class="min-w-0 flex-1 space-y-2">
                    <div class="ui-skeleton h-3 w-20"></div>
                    <div class="ui-skeleton h-5 w-12"></div>
                </div>
            </div>
        }
    </div>
    <div data-skeleton-content="admin-stats" class="hidden grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="ui-stat-card">
            <span class="ui-stat-icon bg-[var(--vw-accent-bg)] text-[var(--vw-accent-text)]"><i data-lucide="users" class="h-5 w-5"></i></span>
            <div class="min-w-0">
                <div class="text-xs text-slate-500 dark:text-slate-400">Total Candidates</div>
                <div class="ui-stat-value"><span data-count-to="@Model.TotalUsers">0</span></div>
            </div>
        </div>
        <div class="ui-stat-card">
            <span class="ui-stat-icon bg-[var(--vw-info-bg)] text-[var(--vw-info-text)]"><i data-lucide="briefcase" class="h-5 w-5"></i></span>
            <div class="min-w-0">
                <div class="text-xs text-slate-500 dark:text-slate-400">Active Invitations</div>
                <div class="ui-stat-value"><span data-count-to="@activeInvitations">0</span></div>
            </div>
        </div>
        <div class="ui-stat-card">
            <span class="ui-stat-icon bg-[var(--vw-warning-bg)] text-[var(--vw-warning-text)]"><i data-lucide="clipboard-check" class="h-5 w-5"></i></span>
            <div class="min-w-0">
                <div class="text-xs text-slate-500 dark:text-slate-400">Assessments</div>
                <div class="ui-stat-value"><span data-count-to="@Model.TotalExams">0</span></div>
            </div>
        </div>
        <div class="ui-stat-card">
            <span class="ui-stat-icon bg-[var(--vw-success-bg)] text-[var(--vw-success-text)]"><i data-lucide="trending-up" class="h-5 w-5"></i></span>
            <div class="min-w-0">
                <div class="text-xs text-slate-500 dark:text-slate-400">Average Assessment Score</div>
                <div class="ui-stat-value"><span data-count-to="@averageScoreStr" data-count-decimals="1" data-count-suffix="%">0%</span></div>
            </div>
        </div>
    </div>

    @* ===================== Tabs ===================== *@
    <div data-tabs="admin-dash" class="ui-tabbar flex gap-1 overflow-x-auto rounded-xl border border-slate-200 bg-white p-1.5 dark:border-slate-700 dark:bg-slate-800" role="tablist">
        <button type="button" class="ui-tab is-active" data-tabs-trigger="dashboard" role="tab" aria-selected="true">Dashboard</button>
        <button type="button" class="ui-tab" data-tabs-trigger="access" role="tab">Users</button>
        <button type="button" class="ui-tab" data-tabs-trigger="recruiters" role="tab">Recruiters</button>
        <button type="button" class="ui-tab" data-tabs-trigger="hrstaff" role="tab">HR Staff</button>
        <button type="button" class="ui-tab" data-tabs-trigger="candidates" role="tab">Candidates</button>
        <button type="button" class="ui-tab" data-tabs-trigger="jobs" role="tab">Jobs</button>
        <button type="button" class="ui-tab" data-tabs-trigger="assessments" role="tab">Assessments</button>
        <button type="button" class="ui-tab" data-tabs-trigger="interviews" role="tab">Interviews</button>
        <button type="button" class="ui-tab" data-tabs-trigger="offers" role="tab">Offers</button>
        <button type="button" class="ui-tab" data-tabs-trigger="analytics" role="tab">Reports</button>
        <button type="button" class="ui-tab" data-tabs-trigger="auditlogs" role="tab">Audit Logs</button>
        <button type="button" class="ui-tab" data-tabs-trigger="operations" role="tab">Settings</button>
    </div>

    @* ===================== Dashboard tab ===================== *@
    <section data-tabs-panel="dashboard" data-tabs-group="admin-dash" class="space-y-8">

        @* ===================== Priority KPIs ===================== *@
        @* The brief's actual admin priorities, ahead of the pipeline detail —
           each tile is a live count and jumps straight to the tab that owns it. *@
        <div>
            <h2 class="ui-heading-sm mb-3">
                <i data-lucide="gauge" class="h-4 w-4 text-[var(--vw-accent)]"></i>Overview
            </h2>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
                @{
                    var kpiTiles = new (string Label, string Value, string Icon, string Tab)[] {
                        ("Total Candidates", Model.TotalUsers.ToString("N0"), "users", "candidates"),
                        ("Active Jobs", activeJobsCount.ToString("N0"), "briefcase", "jobs"),
                        ("Recruiters", recruiters.Count().ToString("N0"), "user-cog", "recruiters"),
                        ("HR Users", hrStaff.Count.ToString("N0"), "users-round", "hrstaff"),
                        ("Monthly Hiring", monthlyHiredCount.ToString("N0"), "trending-up", "analytics"),
                        ("Pending Offers", pendingOffersCount.ToString("N0"), "file-check", "offers"),
                        ("Reports", reports.Count().ToString("N0"), "bar-chart-3", "analytics"),
                        ("Audit Logs", totalAuditLogsCount.ToString("N0"), "shield", "auditlogs"),
                    };
                }
                @foreach (var kpi in kpiTiles)
                {
                    <button type="button" onclick="window.vwActivateTab('admin-dash','@kpi.Tab')" class="ui-card group flex flex-col items-start gap-2 p-4 text-left transition hover:-translate-y-0.5 hover:border-[var(--vw-accent)]">
                        <span class="ui-stat-icon h-9 w-9 bg-[var(--vw-accent-bg)] text-[var(--vw-accent-text)]"><i data-lucide="@kpi.Icon" class="h-4 w-4"></i></span>
                        <div class="ui-stat-value">@kpi.Value</div>
                        <div class="text-xs font-medium text-slate-500 dark:text-slate-400">@kpi.Label</div>
                    </button>
                }
                @* System Health — no infrastructure monitoring exists in this app to
                   report on, so this is an honest "is the app responding" indicator
                   (you're looking at a rendered admin page, so: yes) rather than a
                   fabricated uptime/latency figure. *@
                <div class="ui-card flex flex-col items-start gap-2 p-4">
                    <span class="ui-stat-icon h-9 w-9 bg-[var(--vw-success-bg)] text-[var(--vw-success-text)]"><i data-lucide="heart-pulse" class="h-4 w-4"></i></span>
                    <div class="ui-stat-value"><span class="ui-badge-success !text-xs">Operational</span></div>
                    <div class="text-xs font-medium text-slate-500 dark:text-slate-400">System Health</div>
                </div>
            </div>
        </div>

        @* ===================== Recruitment Pipeline (summary) ===================== *@
        <div class="ui-card">
            <div class="ui-card-header">
                <h2 class="ui-heading-sm">
                    <i data-lucide="git-branch" class="h-4 w-4 text-[var(--vw-accent)]"></i>Recruitment Pipeline
                </h2>
                <span class="ui-badge-neutral">@dashboardPipelineTotal candidates</span>
            </div>
            <div class="ui-card-body">
                <div class="grid grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2">
                    @foreach (var stage in dashboardPipelineStages)
                    {
                        var pct = dashboardPipelineMax > 0 ? (int)Math.Round(stage.Count * 100.0 / dashboardPipelineMax) : 0;
                        <div>
                            <div class="mb-1 flex items-center justify-between text-xs">
                                <span class="font-medium text-slate-600 dark:text-slate-300">@stage.Label</span>
                                <span class="font-semibold text-slate-800 dark:text-slate-100">@stage.Count</span>
                            </div>
                            <div class="ui-progress">
                                <div class="ui-progress-bar" style="width:@(pct)%" role="progressbar" aria-valuenow="@stage.Count" aria-valuemin="0" aria-valuemax="@dashboardPipelineMax" aria-label="@stage.Label"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ===================== Quick Actions ===================== *@
        @* Surfaces Admin's own domain first (staff/roles, system config, analytics) —
           Candidates/Assessments/Pipeline are still one click away via the tab bar above
           and the sections below; this just stops them from being the first three things
           an Admin sees, since day-to-day candidate screening is Recruiter's job. *@
        <div>
            <h2 class="ui-heading-sm mb-3">
                <i data-lucide="zap" class="h-4 w-4 text-[var(--vw-accent)]"></i>Quick Actions
            </h2>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                <button type="button" onclick="window.vwActivateTab('admin-dash','access')" class="ui-card group flex items-center gap-3 p-4 text-start hover:-translate-y-0.5 hover:border-[var(--vw-accent)]">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-[var(--vw-accent-bg)] text-[var(--vw-accent-text)] transition-colors group-hover:bg-[var(--vw-accent)] group-hover:text-white">
                        <i data-lucide="shield-check" class="h-5 w-5"></i>
                    </span>
                    <span class="min-w-0">
                        <span class="block text-sm font-semibold text-slate-900 dark:text-white">Manage Staff &amp; Roles</span>
                        <span class="block text-xs text-slate-500 dark:text-slate-400">Add staff, assign roles</span>
                    </span>
                </button>
                <button type="button" onclick="window.vwActivateTab('admin-dash','operations')" class="ui-card group flex items-center gap-3 p-4 text-start hover:-translate-y-0.5 hover:border-[var(--vw-accent)]">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-[var(--vw-info-bg)] text-[var(--vw-info-text)] transition-colors group-hover:bg-[var(--vw-accent)] group-hover:text-white">
                        <i data-lucide="settings" class="h-5 w-5"></i>
                    </span>
                    <span class="min-w-0">
                        <span class="block text-sm font-semibold text-slate-900 dark:text-white">System Settings</span>
                        <span class="block text-xs text-slate-500 dark:text-slate-400">Configuration &amp; notifications</span>
                    </span>
                </button>
                <button type="button" onclick="window.vwActivateTab('admin-dash','analytics')" class="ui-card group flex items-center gap-3 p-4 text-start hover:-translate-y-0.5 hover:border-[var(--vw-accent)]">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-[var(--vw-success-bg)] text-[var(--vw-success-text)] transition-colors group-hover:bg-[var(--vw-accent)] group-hover:text-white">
                        <i data-lucide="bar-chart-3" class="h-5 w-5"></i>
                    </span>
                    <span class="min-w-0">
                        <span class="block text-sm font-semibold text-slate-900 dark:text-white">View Analytics</span>
                        <span class="block text-xs text-slate-500 dark:text-slate-400">Hiring funnel &amp; reports</span>
                    </span>
                </button>
            </div>
        </div>

        @* ===================== Candidate Summary ===================== *@
        <div class="ui-card">
            <div class="ui-card-header">
                <h2 class="ui-heading-sm">
                    <i data-lucide="graduation-cap" class="h-4 w-4 text-[var(--vw-accent)]"></i>Candidate Summary
                </h2>
                <a asp-action="Students" class="ui-btn-ghost !px-3 !py-1.5 text-xs">View candidates →</a>
            </div>
            <div class="ui-card-body">
                <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
                    <div>
                        <div class="text-xs text-slate-500 dark:text-slate-400">Needs Review</div>
                        <div class="ui-stat-figure">@stageCount(RecruitmentStages.ProfileUnderReview)</div>
                    </div>
                    <div>
                        <div class="text-xs text-slate-500 dark:text-slate-400">Shortlisted</div>
                        <div class="ui-stat-figure">@shortlistedCount</div>
                    </div>
                    <div>
                        <div class="text-xs text-slate-500 dark:text-slate-400">Onboarding</div>
                        <div class="ui-stat-figure">@onboardingCount</div>
                    </div>
                    <div>
                        <div class="text-xs text-slate-500 dark:text-slate-400">Rejected</div>
                        <div class="ui-stat-figure">@stageCount(RecruitmentStages.Rejected)</div>
                    </div>
                </div>
            </div>
        </div>

        @* ===================== Upcoming Assessments ===================== *@
        <div class="ui-card">
            <div class="ui-card-header">
                <h2 class="ui-heading-sm">
                    <i data-lucide="calendar-clock" class="h-4 w-4 text-[var(--vw-accent)]"></i>Upcoming Assessments
                </h2>
                <button type="button" class="ui-btn-ghost !px-3 !py-1.5 text-xs" onclick="window.vwActivateTab('admin-dash','assessments')">View all</button>
            </div>
            <ul class="divide-y divide-slate-100 dark:divide-slate-700">
                @if (!upcomingExams.Any())
                {
                    <li>@await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Icon = "calendar-clock", Title = "No upcoming assessments", Message = "Assessments scheduled to open in the future will show up here.", Compact = true })</li>
                }
                @foreach (var exam in upcomingExams)
                {
                    <li class="flex items-start gap-3 px-5 py-3 transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/60">
                        <span class="ui-stat-icon h-9 w-9 bg-[var(--vw-accent-bg)] text-[var(--vw-accent-text)]"><i data-lucide="clipboard-list" class="h-4 w-4"></i></span>
                        <div class="min-w-0 flex-1">
                            <div class="text-sm font-medium text-slate-800 dark:text-slate-100">@exam.Title</div>
                            <div class="text-xs text-slate-500 dark:text-slate-400">Opens @exam.StartDateTime?.ToLocalTime().ToString("dd MMM, HH:mm") &middot; @exam.Questions.Count questions</div>
                        </div>
                    </li>
                }
            </ul>
        </div>

        @* ===================== Recent Activity (latest 5, timeline) ===================== *@
        <div class="ui-card">
            <div class="ui-card-header">
                <h2 class="ui-heading-sm">
                    <i data-lucide="history" class="h-4 w-4 text-[var(--vw-accent)]"></i>Recent Activity
                </h2>
                <button type="button" class="ui-btn-ghost !px-3 !py-1.5 text-xs" onclick="window.vwActivateTab('admin-dash','operations')">View all</button>
            </div>
            <div class="ui-card-body">
                <ol data-skeleton="admin-activity" class="space-y-5">
                    @for (int i = 0; i < 5; i++)
                    {
                        <li class="flex items-start gap-3">
                            <div class="ui-skeleton h-8 w-8 shrink-0 rounded-full"></div>
                            <div class="min-w-0 flex-1 space-y-2 pt-0.5">
                                <div class="ui-skeleton h-3.5 w-3/4"></div>
                                <div class="ui-skeleton h-3 w-1/3"></div>
                            </div>
                        </li>
                    }
                </ol>
                @if (!recentActivity.Any())
                {
                    <div data-skeleton-content="admin-activity" class="hidden">
                        @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Icon = "activity", Title = "No activity yet", Message = "Actions taken across the portal will show up here as they happen.", Compact = true })
                    </div>
                }
                else
                {
                    <ol data-skeleton-content="admin-activity" class="hidden relative space-y-5 before:absolute before:bottom-1 before:left-4 before:top-1 before:w-px before:bg-slate-200 before:content-[''] dark:before:bg-slate-700">
                        @foreach (var item in recentActivity)
                        {
                            <li class="relative flex items-start gap-3">
                                <span class="ui-stat-icon relative z-10 h-8 w-8 shrink-0 bg-slate-100 text-slate-500 ring-4 ring-[var(--vw-surface)] dark:bg-slate-700 dark:text-slate-300"><i data-lucide="@item.Icon" class="h-3.5 w-3.5"></i></span>
                                <div class="min-w-0 flex-1 rounded-lg px-1 py-0.5 transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/60">
                                    <div class="text-sm font-medium text-slate-800 dark:text-slate-100">@item.Text</div>
                                    <div class="text-xs text-slate-500 dark:text-slate-400">@item.Sub &middot; @item.When.ToLocalTime().ToString("dd MMM, HH:mm")</div>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </div>
        </div>

        @* ===================== Notifications (Security & Platform Alerts) =====================
           Admin-only, actionable signals — failed logins / security events / platform
           health — built by ActivityFeedService.BuildAdminAlerts. Distinct from the
           "Notifications and Proctoring" panel on the Operations tab, which is the
           outbound-email dispatch queue (a different, operational concern). *@
        <div class="ui-card">
            <div class="ui-card-header">
                <h2 class="ui-heading-sm">
                    <i data-lucide="bell" class="h-4 w-4 text-[var(--vw-accent)]"></i>Notifications
                </h2>
            </div>
            <div class="ui-card-body">
                @if (!adminAlerts.Any())
                {
                    @await Html.PartialAsync("_EmptyState", new EmptyStateViewModel { Icon = "bell", Title = "No alerts", Message = "Security and platform signals will show up here.", Compact = true, Variant = "success" })
                }
                else
                {
                    <ul class="space-y-3">
                        @foreach (var alert in adminAlerts)
                        {
                            var alertColor = alert.Severity switch { "danger" => "text-[var(--vw-danger)]", "warning" => "text-[var(--vw-warning)]", "success" => "text-[var(--vw-success)]", _ => "text-slate-400" };
                            <li class="flex items-start gap-3">
                                <span class="ui-stat-icon h-9 w-9 shrink-0 bg-slate-100 @alertColor dark:bg-slate-700"><i data-lucide="@alert.Icon" class="h-4 w-4"></i></span>
                                <div class="min-w-0 flex-1">
                                    <div class="text-sm font-medium text-slate-800 dark:text-slate-100">@alert.Title</div>
                                    <div class="text-xs text-slate-500 dark:text-slate-400">@alert.Detail</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
